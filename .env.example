# InvoiceGuard environment. Copy to `.env` for local development:  cp .env.example .env
# Values below are LOCAL DEVELOPMENT defaults for services bound to 127.0.0.1, not secrets.
# Production values come from the platform's secret store, never from a committed file.
# Each process validates only what it needs (packages/shared/src/env.ts).
# Variables for later milestones (encryption, extraction, Stripe) are added with the
# milestone that uses them.

NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Web ---------------------------------------------------------------------------------
APP_URL=http://localhost:3000
# Keys the HMAC used to store session and email-link tokens (min 32 characters). Generate a
# real one for any shared environment:  node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
# Rotating it signs everyone out and invalidates outstanding email links.
SESSION_SECRET=local-dev-session-secret-change-me-0123456789
# Only set true behind a proxy that overwrites X-Forwarded-For (audit log client IP).
TRUST_PROXY_HEADERS=false

# --- Email ---------------------------------------------------------------------------------
EMAIL_FROM="InvoiceGuard <no-reply@invoiceguard.localhost>"
# file: writes each message as an .eml file (native dev, no mail server). Rejected in production.
# smtp: any SMTP server. Docker dev runs Mailpit (web UI http://localhost:8025).
EMAIL_TRANSPORT=file
EMAIL_FILE_DIR=.local/mail
# To use Mailpit instead, set EMAIL_TRANSPORT=smtp and uncomment:
# SMTP_URL=smtp://localhost:1025

# --- Postgres ----------------------------------------------------------------------------
# App role: not superuser, cannot bypass row-level security. Used by web and worker.
DATABASE_URL=postgres://ig_app:ig_app_dev_password@localhost:5432/invoiceguard
# Owner role: runs migrations only (`pnpm db:migrate`).
DATABASE_OWNER_URL=postgres://ig_owner:ig_owner_dev_password@localhost:5432/invoiceguard
# Superuser: local bootstrap only (`pnpm services:native` creates roles and the database).
# Never set in deployed environments.
DATABASE_ADMIN_URL=postgres://postgres:postgres_dev_password@localhost:5432/postgres

# --- Redis (BullMQ) -----------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Worker ------------------------------------------------------------------------------
WORKER_CONCURRENCY=4

# --- Object storage -----------------------------------------------------------------------
# fs: local directory, works with or without Docker. Rejected when NODE_ENV=production.
# s3: any S3-compatible service (Docker dev uses RustFS on :9000).
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=.local/storage

# To use the Docker S3 service instead, set STORAGE_DRIVER=s3 and uncomment:
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=invoiceguard-dev
# S3_ACCESS_KEY_ID=invoiceguard
# S3_SECRET_ACCESS_KEY=invoiceguard_dev_secret
# S3_FORCE_PATH_STYLE=true
